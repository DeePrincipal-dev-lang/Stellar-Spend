    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "target": "ES2020"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
